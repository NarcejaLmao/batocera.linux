# Fragment on top of the arm64 "defconfig" for the Anbernic RG Rotate (Unisoc UMS512).
# Symbols taken from the rg-rotate bring-up notes; verify against branch rg-rotate of
# github.com/beebono/linux-mainline-sprd (unknown symbols are ignored by the merge).
CONFIG_ARCH_SPRD=y
CONFIG_LOCALVERSION="-batocera-ums512"

# Console: USB gadget serial is the only console (no UART on the board)
CONFIG_USB_G_SERIAL=y
CONFIG_USB_CONFIGFS=y

# USB dual-role OTG (dr_mode must stay otg) + Type-C role switching
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC=y
CONFIG_USB_CONN_GPIO=y
CONFIG_EXTCON_USB_GPIO=y

# Storage / buses
CONFIG_MMC_SDHCI_SPRD=y
CONFIG_I2C_SPRD=y

# Display / GPU (Mali-G52 through panfrost)
CONFIG_DRM_PANFROST=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DMABUF_HEAPS=y

# Power
CONFIG_CHARGER_BQ2415X=y
CONFIG_REGULATOR_FAN53555=y

# Input
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_EVDEV=y

# DVFS / cpufreq
CONFIG_ARM_SPRD_CPUFREQ_HW=y

# Needed for debugging/bring-up
CONFIG_DEVMEM=y
# CONFIG_MALI_DEVFREQ is not set
